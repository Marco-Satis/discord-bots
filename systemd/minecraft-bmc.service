[Unit]
Description=Minecraft Better MC Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/home/minecraft/bettermc

# Java-Startbefehl — Speicher und Jar-Name anpassen!
ExecStart=/usr/bin/java -Xms4G -Xmx8G -jar server.jar nogui

# Graceful Shutdown via RCON (optional, falls stop-Befehl noetig)
ExecStop=/usr/bin/rcon-cli --host 127.0.0.1 --port 25575 --password RCON_PASSWORD stop
TimeoutStopSec=60

Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=3

# Resource Limits
MemoryMax=10G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minecraft-bmc

[Install]
WantedBy=multi-user.target
