[Unit]
Description=Discord Recon (Health Check, Dashboard, Scheduler)
Documentation=https://github.com/your-repo/discord-bots
After=network-online.target operator-bot.service
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/home/botuser/Discord_Bots
ExecStart=/home/botuser/Discord_Bots/venv/bin/python -u bots/recon_bot.py
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=5

# Environment
EnvironmentFile=/home/botuser/Discord_Bots/config/.env

# Security hardening
# NoNewPrivileges=yes  -- REMOVED: blocks sudo which is needed for systemctl/renice
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/botuser/Discord_Bots/data
ReadWritePaths=/home/botuser/Discord_Bots/logs
ReadWritePaths=/home/botuser/Discord_Bots/backups
# MC-Server-Dirs: recon-bot fuehrt Modpack-Updates aus (create_staging/World-Backup/
# Install unter /home/minecraft, bmc5 + vanilla). Ohne dies -> OSError Errno 30 EROFS
# trotz rw-Mount, weil ProtectHome=read-only /home sonst nur-lesbar macht.
# (Fix 2026-07-07; NICHT entfernen, sonst schlaegt das Modpack-Update wieder fehl.)
ReadWritePaths=/home/minecraft
PrivateTmp=yes
# ProtectKernelTunables=yes  -- REMOVED: blocks drop_caches for optimizer
ProtectControlGroups=yes
# RestrictSUIDSGID=yes  -- REMOVED: blocks sudo setuid

# Resource limits (monitor needs more for psutil + steamcmd)
MemoryMax=768M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=recon-bot

[Install]
WantedBy=multi-user.target
