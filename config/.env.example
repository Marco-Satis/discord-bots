# ============================================================
# Discord Bot Configuration - .env
# Copy to .env and fill in your values:
#   cp .env.example .env && nano .env
# ============================================================

# === DISCORD BOT TOKENS ===
DISCORD_TOKEN_MANAGER=DEIN_GAMESERVER_BOT_TOKEN
DISCORD_TOKEN_WATCHDOG=DEIN_MONITOR_BOT_TOKEN
GUILD_ID=DEINE_GUILD_ID

# === PERMISSIONS ===
OWNER_ID=1000000000000000001
ADMIN_ROLE_ID=1000000000000000002
SATISFACTORY_ROLE_ID=1000000000000000004

# === CHANNELS ===
ADMIN_LOG_CHANNEL_ID=1000000000000000005
PUBLIC_STATUS_CHANNEL_ID=1000000000000000003
GAME_CHAT_CHANNEL_ID=
STATUS_EMBED_CHANNEL_ID=

# === VOICE CHANNEL STATS (Monitor Bot, optional) ===
VOICE_STATS_CATEGORY_ID=
NOTIFY_ROLE_ID=

# === SATISFACTORY SERVER ===
SATISFACTORY_SERVICE=satisfactory.service
SATISFACTORY_USER=satisfactory
SATISFACTORY_SERVER_PATH=/home/satisfactory/SatisfactoryDedicatedServer

# === SATISFACTORY API ===
API_HOST=127.0.0.1
API_PORT=7777
API_TOKEN=
API_VERIFY_SSL=false

# === STEAMCMD ===
SATISFACTORY_SAVE_PATH=/home/satisfactory/.config/Epic/FactoryGame/Saved/SaveGames
STEAMCMD_PATH=/usr/games/steamcmd

# === BACKUP ===
BACKUP_PATH=/home/botuser/Discord_Bots/backups

# === ONEDRIVE CLOUD BACKUP (optional, needs rclone) ===
ONEDRIVE_ENABLED=false
ONEDRIVE_REMOTE=onedrive
ONEDRIVE_PATH=SatisfactoryBackups

# === EMAIL NOTIFICATIONS (optional) ===
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# === SERVER INFO ===
SERVER_IP=203.0.113.10

# === MINECRAFT MULTI-SERVER (Phase 14) ===
# Pro Server: MC_{SERVER_ID}_* Variablen setzen.
# Server ist aktiviert sobald MC_{ID}_SERVICE gesetzt ist.
# Unterstuetzte Server-IDs: BMC (Better MC), VANILLA

# --- Better MC Server ---
MC_BMC_DISPLAY_NAME=Better MC
MC_BMC_SERVICE=minecraft-bmc.service
MC_BMC_PATH=/home/minecraft/bettermc
MC_BMC_WORLD_PATH=/home/minecraft/bettermc/world
MC_BMC_RCON_HOST=127.0.0.1
MC_BMC_RCON_PORT=25575
MC_BMC_RCON_PASSWORD=
MC_BMC_BACKUP_PATH=/home/minecraft/backups/bmc
MC_BMC_LOG_PATH=/home/minecraft/bettermc/logs/latest.log
MC_BMC_GAME_CHAT_CHANNEL_ID=0

# --- Vanilla/Paper Server ---
MC_VANILLA_DISPLAY_NAME=Vanilla
MC_VANILLA_SERVICE=minecraft-vanilla.service
MC_VANILLA_PATH=/home/minecraft/vanilla
MC_VANILLA_WORLD_PATH=/home/minecraft/vanilla/world
MC_VANILLA_RCON_HOST=127.0.0.1
MC_VANILLA_RCON_PORT=25576
MC_VANILLA_RCON_PASSWORD=
MC_VANILLA_BACKUP_PATH=/home/minecraft/backups/vanilla
MC_VANILLA_LOG_PATH=/home/minecraft/vanilla/logs/latest.log
MC_VANILLA_GAME_CHAT_CHANNEL_ID=0

# === MINECRAFT ROLE (fuer /mc Commands) ===
MINECRAFT_ROLE_ID=0
