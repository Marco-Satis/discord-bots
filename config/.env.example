# ============================================================
#  Discord Bot System — Environment Configuration
#  Version: 3.2.0
#
#  Einrichtung:
#    cp .env.example .env && nano .env
#
#  Hinweis: Nur Variablen mit leerem Wert muessen ausgefuellt
#  werden. Vorausgefuellte Werte sind Defaults/Beispiele.
# ============================================================


# ┌──────────────────────────────────────────────────────────┐
# │  1. DISCORD — Tokens & Server                           │
# └──────────────────────────────────────────────────────────┘

DISCORD_TOKEN_MANAGER=              # GameServer Bot Token (Bot 1)
DISCORD_TOKEN_WATCHDOG=             # Monitor Bot Token (Bot 2)
ADMIN_BOT_TOKEN=                    # Admin Bot Token (Bot 3, optional)
GUILD_ID=                           # Discord Server ID


# ┌──────────────────────────────────────────────────────────┐
# │  2. DISCORD — Rollen & Berechtigungen                   │
# └──────────────────────────────────────────────────────────┘

OWNER_ID=1000000000000000001        # Bot-Owner (volle Kontrolle)
ADMIN_ROLE_ID=1000000000000000002   # Admin-Rolle (Server steuern)
SATISFACTORY_ROLE_ID=1000000000000000004  # Spieler-Rolle (SAT)
MINECRAFT_ROLE_ID=0                 # Spieler-Rolle (MC, 0 = deaktiviert)
NOTIFY_ROLE_ID=                     # Benachrichtigungs-Rolle (optional)


# ┌──────────────────────────────────────────────────────────┐
# │  3. DISCORD — Channels                                  │
# └──────────────────────────────────────────────────────────┘

ADMIN_LOG_CHANNEL_ID=1000000000000000005  # Admin-Log + Benachrichtigungen
PUBLIC_STATUS_CHANNEL_ID=1000000000000000003  # Oeffentlicher Status-Channel
STATUS_EMBED_CHANNEL_ID=            # Dashboard-Embed Channel (optional)
VOICE_STATS_CATEGORY_ID=            # Voice-Channel Stats Kategorie (optional)


# ┌──────────────────────────────────────────────────────────┐
# │  4. SATISFACTORY — Server                               │
# └──────────────────────────────────────────────────────────┘

SATISFACTORY_SERVICE=satisfactory.service
SATISFACTORY_USER=satisfactory
SATISFACTORY_SERVER_PATH=/home/satisfactory/SatisfactoryDedicatedServer
SATISFACTORY_SAVE_PATH=/home/satisfactory/.config/Epic/FactoryGame/Saved/SaveGames

# API-Verbindung
API_HOST=127.0.0.1
API_PORT=7777
API_TOKEN=                          # Satisfactory API Token (Pflicht)
API_VERIFY_SSL=false

# SteamCMD (fuer Updates)
STEAMCMD_PATH=/usr/games/steamcmd


# ┌──────────────────────────────────────────────────────────┐
# │  5. MINECRAFT — Server (pro Server ein Block)           │
# │                                                         │
# │  Prefix: MC_{SERVER_ID}_*                               │
# │  Server ist aktiv sobald MC_{ID}_SERVICE gesetzt ist.   │
# │  Unterstuetzte IDs: BMC, VANILLA                        │
# └──────────────────────────────────────────────────────────┘

# --- Better MC (BMC3 Fabric) ---
MC_BMC_DISPLAY_NAME=Better MC
MC_BMC_SERVICE=minecraft-bmc.service
MC_BMC_PATH=/home/minecraft/bettermc
MC_BMC_WORLD_PATH=/home/minecraft/bettermc/world
MC_BMC_RCON_HOST=127.0.0.1
MC_BMC_RCON_PORT=25575
MC_BMC_RCON_PASSWORD=               # RCON-Passwort (Pflicht fuer Steuerung)
MC_BMC_BACKUP_PATH=/home/minecraft/backups/bmc
MC_BMC_LOG_PATH=/home/minecraft/bettermc/logs/latest.log
MC_BMC_GAME_CHAT_CHANNEL_ID=0      # Discord Chat-Bridge Channel (0 = aus)

# --- Vanilla/Paper ---
MC_VANILLA_DISPLAY_NAME=Vanilla
MC_VANILLA_SERVICE=minecraft-vanilla.service
MC_VANILLA_PATH=/home/minecraft/vanilla
MC_VANILLA_WORLD_PATH=/home/minecraft/vanilla/world
MC_VANILLA_RCON_HOST=127.0.0.1
MC_VANILLA_RCON_PORT=25576
MC_VANILLA_RCON_PASSWORD=           # RCON-Passwort (Pflicht fuer Steuerung)
MC_VANILLA_BACKUP_PATH=/home/minecraft/backups/vanilla
MC_VANILLA_LOG_PATH=/home/minecraft/vanilla/logs/latest.log
MC_VANILLA_GAME_CHAT_CHANNEL_ID=0  # Discord Chat-Bridge Channel (0 = aus)


# ┌──────────────────────────────────────────────────────────┐
# │  6. BACKUP & CLOUD                                      │
# └──────────────────────────────────────────────────────────┘

BACKUP_PATH=/home/botuser/Discord_Bots/backups

# OneDrive Cloud-Backup (optional, benoetigt rclone)
ONEDRIVE_ENABLED=false
ONEDRIVE_REMOTE=onedrive
ONEDRIVE_PATH=SatisfactoryBackups


# ┌──────────────────────────────────────────────────────────┐
# │  7. EMAIL — Benachrichtigungen (optional)               │
# └──────────────────────────────────────────────────────────┘

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=


# ┌──────────────────────────────────────────────────────────┐
# │  8. SERVER-INFO                                         │
# └──────────────────────────────────────────────────────────┘

SERVER_IP=203.0.113.10


# ┌──────────────────────────────────────────────────────────┐
# │  9. WEB-STATUS-SEITE (Phase 8g)                        │
# └──────────────────────────────────────────────────────────┘

WEB_STATUS_ENABLED=false               # true = HTML-Seite alle 60s generieren
WEB_STATUS_PATH=/var/www/status        # Ausgabe-Verzeichnis


# ┌──────────────────────────────────────────────────────────┐
# │ 10. MODPACK-UPDATE-CHECK (Phase 8h)                    │
# └──────────────────────────────────────────────────────────┘

MC_BMC_MODPACK_ID=                     # Modrinth/CurseForge Projekt-ID
MC_BMC_MODPACK_VERSION=                # Aktuell installierte Version
MC_BMC_MODPACK_SOURCE=modrinth         # "modrinth" oder "curseforge"
CURSEFORGE_API_KEY=                    # CurseForge API Key (nur bei source=curseforge)


# ┌──────────────────────────────────────────────────────────┐
# │ 11. CONFIG-BACKUP VERSCHLUESSELUNG (Phase 8d)          │
# └──────────────────────────────────────────────────────────┘

GPG_PASSPHRASE=                        # Passphrase fuer GPG-Verschluesselung (optional)


# ┌──────────────────────────────────────────────────────────┐
# │ 12. TEAMSPEAK — ServerQuery (Phase 12b-d, optional)     │
# └──────────────────────────────────────────────────────────┘

TS_ENABLED=false                       # true = TeamSpeak-Integration aktivieren
TS_HOST=                               # TeamSpeak Server IP/Hostname
TS_PORT=10011                          # ServerQuery Port (Standard: 10011)
TS_USER=serveradmin                    # ServerQuery Benutzername
TS_PASSWORD=                           # ServerQuery Passwort
TS_SERVER_ID=1                         # Virtuelle Server-ID (Standard: 1)


# ┌──────────────────────────────────────────────────────────┐
# │ 13. WEB-DASHBOARD (Phase 13)                            │
# └──────────────────────────────────────────────────────────┘

WEB_ENABLED=false                         # true = Web Dashboard aktivieren
WEB_PORT=8080                             # Port fuer das Web Dashboard
WEB_HTTPS=true                            # true = secure Cookies (bei HTTPS-Domain)
WEB_DOMAIN=marco-satisfactory.duckdns.org # Domain fuer CORS-Policy
WEB_SECRET_KEY=                           # JWT Secret (mindestens 32 Zeichen)
WEB_ADMIN_USER=admin                      # Fallback-Login Benutzername
WEB_ADMIN_PASS_HASH=                      # bcrypt-Hash des Passworts
DISCORD_CLIENT_ID=                        # Discord OAuth2 Application Client ID
DISCORD_CLIENT_SECRET=                    # Discord OAuth2 Application Client Secret
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
WEB_WEBMIN_URL=https://localhost:10000   # Webmin-URL fuer System-Seite (iframe)
