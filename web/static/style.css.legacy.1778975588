/* ============================================================
 *  Dashboard v4.1 — KAMINO-inspired Dark Theme
 *
 *  Layout: KAMINO Crypto Liquidity Page
 *  Farbschema: Blau (eigenes)
 *    - Hintergrund:  #060a13
 *    - Sidebar:      #0a0f1e
 *    - Karten:       #0d1321
 *    - Akzent:       #3b82f6
 * ============================================================ */

/* --- CSS Variablen --- */
:root {
    --bg-primary: #060a13;
    --bg-sidebar: #0a0f1e;
    --bg-card: #0d1321;
    --bg-card-hover: #111827;
    --bg-input: #0a1020;
    --bg-hover: #131d35;
    --accent: #3b82f6;
    --accent-light: #60a5fa;
    --accent-glow: rgba(59, 130, 246, 0.12);
    --accent-border: rgba(59, 130, 246, 0.25);
    --text-primary: #e2e8f0;
    --text-secondary: #94a3b8;
    --text-muted: #475569;
    --text-dim: #334155;
    --border-color: rgba(148, 163, 184, 0.06);
    --border-subtle: rgba(148, 163, 184, 0.04);
    --border-card: rgba(148, 163, 184, 0.08);
    --success: #22c55e;
    --success-dim: rgba(34, 197, 94, 0.12);
    --warning: #f59e0b;
    --warning-dim: rgba(245, 158, 11, 0.12);
    --danger: #ef4444;
    --danger-dim: rgba(239, 68, 68, 0.12);
    --info: #38bdf8;
    --info-dim: rgba(56, 189, 248, 0.12);
    --discord-blurple: #5865F2;
    --sidebar-width: 240px;
    --radius: 16px;
    --radius-md: 12px;
    --radius-sm: 8px;
    --radius-xs: 4px;
    --shadow: 0 0 0 1px var(--border-card);
    --shadow-lg: 0 4px 24px rgba(0, 0, 0, 0.3);
    --transition: 0.2s ease;
}

/* --- Reset & Basis --- */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: 15px;
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
}

a {
    color: var(--accent-light);
    text-decoration: none;
}

a:hover {
    color: var(--text-primary);
}


/* ============================================================
 *  Sidebar — Schlank, minimalistisch
 * ============================================================ */

.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background: var(--bg-sidebar);
    display: flex;
    flex-direction: column;
    z-index: 1000;
    border-right: 1px solid var(--border-color);
    transition: transform var(--transition);
}

.sidebar-header {
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--border-color);
}

.sidebar-logo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.3px;
}

.sidebar-user {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-color);
}

.user-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
}

.user-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 0.75rem;
}

.user-name {
    font-size: 0.82rem;
    color: var(--text-primary);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sidebar-nav {
    flex: 1;
    padding: 0.4rem 0;
    overflow-y: auto;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 450;
    transition: all var(--transition);
    border-left: 2px solid transparent;
    margin: 0;
}

.nav-item:hover {
    background: var(--bg-hover);
    color: var(--text-secondary);
}

.nav-item.active {
    background: var(--accent-glow);
    color: var(--accent-light);
    border-left-color: var(--accent);
    font-weight: 550;
}

.nav-icon {
    font-size: 0.9rem;
    width: 20px;
    text-align: center;
    opacity: 0.6;
}

.nav-item:hover .nav-icon,
.nav-item.active .nav-icon {
    opacity: 1;
}

.nav-logout {
    margin-top: auto;
    border-top: 1px solid var(--border-color);
}

.sidebar-footer {
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--border-color);
    color: var(--text-dim);
    text-align: center;
    font-size: 0.72rem;
}

.sidebar-toggle {
    display: none;
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1100;
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    font-size: 1.1rem;
    cursor: pointer;
}


/* ============================================================
 *  Hauptinhalt
 * ============================================================ */

.main-content {
    margin-left: var(--sidebar-width);
    flex: 1;
    padding: 1.75rem 2.25rem;
    min-height: 100vh;
    max-width: 1400px;
}

.page-header {
    margin-bottom: 1.75rem;
}

.page-header h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
    letter-spacing: -0.4px;
}

.page-subtitle {
    color: var(--text-muted);
    font-size: 0.85rem;
}


/* ============================================================
 *  KAMINO-Style Hero Stat Cards
 * ============================================================ */

.hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 2rem;
}

.hero-stat {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius);
    padding: 1.25rem 1.25rem 1rem;
    position: relative;
    overflow: hidden;
    transition: all var(--transition);
}

.hero-stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: var(--radius) var(--radius) 0 0;
}

.hero-stat--blue::before { background: var(--accent); }
.hero-stat--green::before { background: var(--success); }
.hero-stat--amber::before { background: var(--warning); }
.hero-stat--red::before { background: var(--danger); }
.hero-stat--info::before { background: var(--info); }

.hero-stat:hover {
    border-color: var(--accent-border);
    background: var(--bg-card-hover);
}

.hero-stat__label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 500;
    margin-bottom: 0.65rem;
}

.hero-stat__value {
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.1;
    color: var(--text-primary);
}

.hero-stat__sub {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
}


/* ============================================================
 *  Sections & Karten
 * ============================================================ */

.section {
    margin-bottom: 1.75rem;
}

.section-title {
    font-size: 0.72rem;
    font-weight: 600;
    margin-bottom: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding-bottom: 0;
    border-bottom: none;
}

.subsection-title {
    font-size: 0.92rem;
    font-weight: 600;
    margin: 1.25rem 0 0.75rem;
    color: var(--text-secondary);
}


/* ============================================================
 *  Server-Tiles (KAMINO Card Style)
 * ============================================================ */

.tile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
}

.tile {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: all var(--transition);
    position: relative;
}

.tile:hover {
    border-color: var(--accent-border);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

.tile-empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--text-secondary);
    padding: 2.5rem;
}

.tile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.tile-name {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.2px;
}

.status-badge {
    padding: 0.15rem 0.6rem;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

.status-online {
    background: var(--success-dim);
    color: var(--success);
    border: 1px solid rgba(34, 197, 94, 0.15);
}

.status-offline {
    background: var(--danger-dim);
    color: var(--danger);
    border: 1px solid rgba(239, 68, 68, 0.15);
}

.status-unknown {
    background: rgba(148, 163, 184, 0.08);
    color: var(--text-muted);
    border: 1px solid rgba(148, 163, 184, 0.1);
}

.tile-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
}

.tile-stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.15rem 0;
}

.stat-label {
    color: var(--text-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
}

.stat-value {
    font-weight: 600;
    font-size: 0.88rem;
}

.tile-actions {
    display: flex;
    gap: 0.4rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-color);
}


/* ============================================================
 *  Stats / Performance (KAMINO-style)
 * ============================================================ */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
}

.stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: all var(--transition);
}

.stat-card:hover {
    border-color: var(--accent-border);
}

.stat-card h4 {
    font-size: 0.68rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}

.stat-number {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
}

.progress-bar {
    height: 4px;
    background: rgba(148, 163, 184, 0.06);
    border-radius: 2px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.5s ease;
}

.progress-ok { background: linear-gradient(90deg, #22c55e, #4ade80); }
.progress-warning { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
.progress-danger { background: linear-gradient(90deg, #ef4444, #f87171); }


/* ============================================================
 *  Bot-Status Leiste
 * ============================================================ */

.bot-status-bar {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
}

.bot-card {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    min-width: 180px;
    transition: all var(--transition);
}

.bot-card:hover {
    border-color: var(--accent-border);
}

.bot-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}

.indicator-online {
    background: var(--success);
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
}

.indicator-offline {
    background: var(--danger);
    box-shadow: 0 0 6px rgba(239, 68, 68, 0.3);
}

.indicator-unknown {
    background: var(--text-dim);
}

.bot-info {
    display: flex;
    flex-direction: column;
}

.bot-name {
    font-weight: 600;
    font-size: 0.82rem;
}

.bot-detail {
    font-size: 0.72rem;
    color: var(--text-muted);
}


/* ============================================================
 *  Ereignis-Feed
 * ============================================================ */

.event-list {
    list-style: none;
}

.event-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.82rem;
}

.event-time {
    color: var(--text-dim);
    font-size: 0.72rem;
    min-width: 130px;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-weight: 400;
}

.event-type {
    padding: 0.12rem 0.45rem;
    border-radius: var(--radius-xs);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    min-width: 56px;
    text-align: center;
    letter-spacing: 0.4px;
}

.badge-info { background: var(--info-dim); color: var(--info); }
.badge-warning { background: var(--warning-dim); color: var(--warning); }
.badge-error { background: var(--danger-dim); color: var(--danger); }
.badge-success { background: var(--success-dim); color: var(--success); }

.event-message {
    flex: 1;
    color: var(--text-secondary);
}

.empty-text {
    color: var(--text-muted);
    text-align: center;
    padding: 2rem;
    font-size: 0.85rem;
}


/* ============================================================
 *  Tabellen (KAMINO-style — integriert in Karten)
 * ============================================================ */

.table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border-card);
    background: var(--bg-card);
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    background: transparent;
}

.data-table th {
    background: rgba(148, 163, 184, 0.03);
    color: var(--text-dim);
    font-weight: 600;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 0.7rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
}

.data-table td {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    vertical-align: top;
}

.data-table tbody tr:hover {
    background: rgba(59, 130, 246, 0.02);
}

.row-error { border-left: 2px solid var(--danger); }
.row-warning { border-left: 2px solid var(--warning); }

.empty-row {
    text-align: center;
    color: var(--text-muted);
    padding: 2.5rem 1rem !important;
}

.col-timestamp {
    white-space: nowrap;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.72rem;
    min-width: 150px;
    color: var(--text-dim);
}

.col-bot { min-width: 120px; }
.col-level { min-width: 80px; }
.col-message { word-break: break-word; }

.level-badge {
    padding: 0.12rem 0.45rem;
    border-radius: var(--radius-xs);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.3px;
}

.level-error { background: var(--danger-dim); color: var(--danger); }
.level-warning { background: var(--warning-dim); color: var(--warning); }

.filter-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
}

.filter-info {
    margin-left: auto;
    color: var(--text-dim);
    font-size: 0.78rem;
}


/* ============================================================
 *  Buttons (modern, clean)
 * ============================================================ */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.25rem;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    font-weight: 550;
    cursor: pointer;
    transition: all var(--transition);
    text-decoration: none;
    line-height: 1.4;
    letter-spacing: -0.1px;
}

.btn:hover {
    transform: translateY(-1px);
}

.btn:active {
    transform: scale(0.98) translateY(0);
}

.btn-primary {
    background: var(--accent);
    color: white;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.25);
}

.btn-primary:hover {
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.35);
    background: #4b8ef7;
}

.btn-secondary {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-card);
}

.btn-secondary:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--accent-border);
}

.btn-danger {
    background: var(--danger);
    color: white;
    box-shadow: 0 2px 8px rgba(239, 68, 68, 0.2);
}

.btn-warning {
    background: var(--warning);
    color: #0b0f1a;
}

.btn-discord {
    background: var(--discord-blurple);
    color: white;
    width: 100%;
    padding: 0.75rem;
    font-size: 1rem;
    border-radius: var(--radius-md);
}

.btn-discord:hover {
    background: #4752c4;
    color: white;
}

.btn-sm {
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    border-radius: 6px;
}

.btn-lg {
    padding: 0.75rem 2rem;
    font-size: 1rem;
}

.btn-full {
    width: 100%;
}


/* ============================================================
 *  Formulare
 * ============================================================ */

.form-group {
    margin-bottom: 1rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.form-group input[type="text"],
.form-group input[type="password"],
.form-group input[type="number"],
.form-group input[type="email"],
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 0.55rem 0.75rem;
    background: var(--bg-input);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.88rem;
    transition: border-color var(--transition), box-shadow var(--transition);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
}

.input-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
}

.form-actions {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
}

/* Toggle Switches */
.toggle-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0.75rem;
}

.toggle-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.toggle-label {
    font-size: 0.88rem;
    color: var(--text-primary);
}

.toggle-switch {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
    flex-shrink: 0;
}

.toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(148, 163, 184, 0.1);
    border: 1px solid var(--border-card);
    border-radius: 22px;
    transition: var(--transition);
}

.toggle-slider::before {
    content: "";
    position: absolute;
    width: 16px;
    height: 16px;
    left: 2px;
    bottom: 2px;
    background: var(--text-muted);
    border-radius: 50%;
    transition: var(--transition);
}

.toggle-switch input:checked + .toggle-slider {
    background: var(--accent);
    border-color: var(--accent);
}

.toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(18px);
    background: white;
}

/* Tab-Navigation (KAMINO-style pill tabs) */
.config-tabs,
.tab-nav,
.detail-tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
    padding: 0.2rem;
    background: rgba(148, 163, 184, 0.03);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
    -webkit-overflow-scrolling: touch;
    flex-wrap: wrap;
    width: fit-content;
}

.config-tabs::-webkit-scrollbar,
.tab-nav::-webkit-scrollbar,
.detail-tabs::-webkit-scrollbar {
    height: 2px;
}

.config-tab,
.tab-btn,
.detail-tab {
    padding: 0.35rem 0.85rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
    line-height: 1.4;
    text-decoration: none;
}

.config-tab:hover,
.tab-btn:hover,
.detail-tab:hover {
    color: var(--text-secondary);
}

.config-tab.active,
.tab-btn.active,
.detail-tab.active {
    background: var(--accent);
    color: white;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.2);
}

.tab-content {
    min-height: 200px;
}

/* Config-Sektionen */
.config-section {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 1.25rem;
}

.config-section .section-title {
    margin-top: 0;
}

.config-form .form-actions .btn {
    min-width: 200px;
}

.stat-sub {
    color: var(--text-dim);
    font-size: 0.72rem;
    margin-top: 0.25rem;
}


/* ============================================================
 *  Alerts
 * ============================================================ */

.alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    font-size: 0.85rem;
    border: 1px solid transparent;
}

.alert-danger {
    background: var(--danger-dim);
    color: var(--danger);
    border-color: rgba(239, 68, 68, 0.12);
}

.alert-success {
    background: var(--success-dim);
    color: var(--success);
    border-color: rgba(34, 197, 94, 0.12);
}

.alert-warning {
    background: var(--warning-dim);
    color: var(--warning);
    border-color: rgba(245, 158, 11, 0.12);
}


/* ============================================================
 *  Login-Seite
 * ============================================================ */

.login-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    background: var(--bg-primary);
}

.login-container {
    width: 100%;
    max-width: 400px;
    padding: 1rem;
}

.login-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    padding: 2rem;
    border-radius: var(--radius);
}

.login-title {
    font-size: 1.35rem;
    text-align: center;
    margin-bottom: 0.25rem;
    font-weight: 700;
    letter-spacing: -0.3px;
}

.login-subtitle {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
}

.login-divider {
    display: flex;
    align-items: center;
    margin: 1.5rem 0;
    color: var(--text-dim);
    font-size: 0.78rem;
}

.login-divider::before,
.login-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border-color);
}

.login-divider span { padding: 0 1rem; }

.login-form .form-group { margin-bottom: 0.75rem; }

.login-footer {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.72rem;
    margin-top: 1.5rem;
}


/* ============================================================
 *  Webmin Iframe
 * ============================================================ */

.iframe-container {
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-card);
}

.webmin-iframe {
    width: 100%;
    height: calc(100vh - 180px);
    border: none;
    background: var(--bg-card);
}


/* ============================================================
 *  Charts / Analytics (KAMINO-style)
 * ============================================================ */

.chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 0.75rem;
}

.chart-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius);
    padding: 1.25rem;
    min-height: 280px;
    position: relative;
    transition: all var(--transition);
}

.chart-card:hover {
    border-color: var(--accent-border);
}

.chart-card h4 {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.chart-card canvas {
    max-height: 220px;
}

.chart-controls {
    display: flex;
    gap: 0.25rem;
    padding: 0.2rem;
    background: rgba(148, 163, 184, 0.03);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    width: fit-content;
}

.chart-period-btn.active {
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.2);
}


/* ============================================================
 *  Sidebar — Server-Links / Separator
 * ============================================================ */

.nav-separator {
    padding: 0.65rem 1rem 0.25rem;
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin-top: 0.25rem;
}

.nav-sub {
    padding-left: 1.75rem;
    font-size: 0.8rem;
}

.nav-sub .nav-icon {
    font-size: 0.55rem;
    color: var(--text-dim);
}


/* ============================================================
 *  HTMX Loading Indicator
 * ============================================================ */

.htmx-indicator { display: none; }

.htmx-request .htmx-indicator,
.htmx-request.htmx-indicator { display: inline-block; }

.htmx-request {
    opacity: 0.6;
    pointer-events: none;
    position: relative;
}

.htmx-request::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0.75rem;
    width: 14px;
    height: 14px;
    border: 2px solid var(--text-dim);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}


/* ============================================================
 *  RCON Console
 * ============================================================ */

.rcon-line {
    padding: 0.25rem 0.5rem;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 0.78rem;
    line-height: 1.5;
    border-bottom: 1px solid rgba(255,255,255,0.02);
}

.rcon-timestamp { color: var(--text-dim); margin-right: 0.5rem; }
.rcon-input { color: var(--accent-light); font-weight: 600; }
.rcon-response .rcon-output { color: var(--success); }
.rcon-error .rcon-output, .rcon-error { color: var(--danger); }


/* ============================================================
 *  Toast / Benachrichtigungen
 * ============================================================ */

.toast-container {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.toast {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    padding: 0.75rem 1.25rem;
    box-shadow: var(--shadow-lg);
    min-width: 280px;
    max-width: 400px;
    animation: slideIn 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.toast-success { border-left: 3px solid var(--success); }
.toast-error { border-left: 3px solid var(--danger); }
.toast-warning { border-left: 3px solid var(--warning); }
.toast-info { border-left: 3px solid var(--info); }

@keyframes slideIn {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}


/* ============================================================
 *  Responsive Design
 * ============================================================ */

@media (max-width: 1200px) {
    .hero-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 1024px) {
    .tile-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }
    .stats-grid {
        grid-template-columns: 1fr;
    }
    .main-content {
        padding: 1.25rem;
    }
}

@media (max-width: 768px) {
    .config-tab, .tab-btn, .detail-tab {
        padding: 0.25rem 0.6rem;
        font-size: 0.7rem;
    }
    .sidebar {
        transform: translateX(-100%);
    }
    .sidebar.open {
        transform: translateX(0);
    }
    .sidebar-toggle {
        display: block;
    }
    .main-content {
        margin-left: 0;
        padding: 1rem;
        padding-top: 3.5rem;
    }
    .hero-stats {
        grid-template-columns: repeat(2, 1fr);
    }
    .tile-grid { grid-template-columns: 1fr; }
    .chart-grid { grid-template-columns: 1fr; }
    .bot-status-bar { flex-direction: column; }
    .toggle-grid { grid-template-columns: 1fr; }
    .input-grid { grid-template-columns: 1fr; }
    .event-item { flex-wrap: wrap; }
    .event-time { min-width: auto; width: 100%; }
}

@media (max-width: 480px) {
    html { font-size: 14px; }
    .hero-stats { grid-template-columns: 1fr; }
    .login-card { padding: 1.5rem; }
    .page-header h1 { font-size: 1.3rem; }
}
